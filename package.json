{
  "name": "discord-bot-aoo",
  "version": "0.3.5",
  "author": "Alexis Besson me@alexis-besson.dev <https://alexis-besson.dev/>",
  "license": "GPL-3.0-or-later",
  "description": "Discord bot specially created for Albion Online game, it allows player to add/list/remove objectives (nodes, cores and vortexes) with all the necessary informations like the type of objective, it's rarity, the map and the time remaining before objective unlock",
  "keywords": [
    "Discord",
    "Bot",
    "Albion Online",
    "Objectives",
    "Slash commands"
  ],
  "main": "dist/src/main.js",
  "type": "module",
  "scripts": {
    "sync-db": "node dist/scripts/sync-db.js",
    "reset-announcement": "pnpm run build && node --env-file=.env.dev dist/scripts/reset-announcement.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "pnpm run build && node --env-file=.env.dev dist/src/main.js",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "prepare": "[ -d .git ] && git config core.hooksPath .githooks || true"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "dependencies": {
    "@logtail/pino": "0.5.8",
    "@sapphire/framework": "5.5.1",
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/postgres": "7.0.0-alpha.48",
    "dayjs": "1.11.23",
    "discord.js": "14.27.0",
    "node-cron": "4.6.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@sapphire/ts-config": "5.0.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "25.2.2",
    "dotenv": "17.4.2",
    "eslint": "9.39.2",
    "globals": "17.11.0",
    "pino-pretty": "13.1.3",
    "tsc-alias": "1.9.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.1",
      "undici": ">=6.27.0 <7",
      "minimatch": ">=9.0.6",
      "dottie": ">=2.0.7",
      "ws": ">=8.21.0",
      "underscore": ">=1.13.8",
      "brace-expansion": ">=5.0.8",
      "picomatch": ">=4.0.4",
      "uuid": ">=11.1.1",
      "@discordjs/builders": "1.14.1"
    }
  }
}
